# Copy to api/.env (git-ignored) and fill in the password.
# If the password has special characters (@ : / # % etc.), URL-encode them, e.g. @ -> %40.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/canyon_dev

# Local development only: accept an X-Dev-User header in place of a real sign-in.
DEV_AUTH=true
