# Copy to api/.env (git-ignored) and fill in the password.
# If the password has special characters (@ : / # % etc.), URL-encode them, e.g. @ -> %40.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/canyon_dev

# Local development only: accept an X-Dev-User header in place of a real sign-in.
DEV_AUTH=true

# Background jobs (Inngest). Leave both unset and /api/inngest doesn't exist.
# Local: `uv run python -m scripts.dev_with_jobs` sets INNGEST_DEV for you (needs DEV_AUTH=true).
# INNGEST_DEV=true
# Production: the signing key from the Inngest dashboard. Every request to /api/inngest must be signed with it.
# INNGEST_SIGNING_KEY=signkey-prod-...
